<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the mark sits inside the safe zone of the foreground layer, so any
     launcher mask (circle, squircle, teardrop) keeps it fully visible. The monochrome
     layer is used for themed icons on Android 13 and newer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/fortiq_surface" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
